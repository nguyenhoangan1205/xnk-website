<%- include('partials/header') %>

<div class="container" style="padding-top:30px;">
  <div class="breadcrumb">
    <a href="/"><%= t('nav.home') %></a> /
    <a href="/news"><%= t('news.page_title') %></a> /
    <%= article.title %>
  </div>

  <section class="block news-article" style="padding-top:0;">
    <% if (article.image) { %>
      <div class="news-hero-image"><img src="<%= article.image %>" alt="<%= article.title %>" /></div>
    <% } %>
    <h1 style="margin:0 0 8px;color:var(--green-900);"><%= article.title %></h1>
    <div class="news-meta"><%= t('news.published_on') %>: <%= article.publishedAt %></div>
    <p style="color:var(--muted);font-size:1.05rem;"><%= article.summary %></p>
    <div class="news-body"><%= article.content %></div>

    <div class="form-actions">
      <a class="btn btn-outline" href="/news">&larr; <%= t('news.back_to_list') %></a>
    </div>
  </section>

  <% if (related.length) { %>
    <section class="block" style="padding-top:10px;">
      <h2 class="section-title"><%= t('news.related_news') %></h2>
      <div class="news-grid">
        <% related.forEach(function(n) { %>
          <a class="news-card" href="/news/<%= n.slug %>">
            <div class="news-thumb">
              <% if (n.image) { %><img src="<%= n.image %>" alt="<%= n.title %>" /><% } else { %><span>📰</span><% } %>
            </div>
            <div class="news-info">
              <span class="news-date"><%= n.publishedAt %></span>
              <h3><%= n.title %></h3>
            </div>
          </a>
        <% }) %>
      </div>
    </section>
  <% } %>
</div>

<%- include('partials/footer') %>
