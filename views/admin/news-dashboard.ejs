<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('admin.news_dashboard') %> | <%= t('site.title') %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-shell">
  <div class="admin-topbar">
    <span class="brand"><%= t('site.title') %> — <%= t('admin.news_dashboard') %></span>
    <div style="display:flex;align-items:center;gap:14px;">
      <span style="font-size:0.85rem;"><%= t('admin.logged_in_as') %>: <%= username %></span>
      <a href="/" style="font-size:0.85rem;color:#cfe4d3;"><%= t('nav.home') %></a>
      <form method="POST" action="/admin/logout">
        <button class="btn btn-small btn-outline" style="color:white;border-color:rgba(255,255,255,0.4);" type="submit"><%= t('admin.logout') %></button>
      </form>
    </div>
  </div>

  <div class="admin-main">
    <div class="admin-subnav">
      <a href="/admin"><%= t('admin.manage_products') %></a>
      <a href="/admin/news" class="active"><%= t('admin.manage_news') %></a>
    </div>

    <div class="admin-header-row">
      <h1 style="margin:0;color:var(--green-900);font-size:1.3rem;"><%= t('admin.news_dashboard') %></h1>
      <a class="btn" href="/admin/news/new">+ <%= t('admin.add_news') %></a>
    </div>

    <% if (flash) { %>
      <div class="flash-msg">
        <% if (flash === 'created') { %><%= t('admin.news_created') %><% } %>
        <% if (flash === 'updated') { %><%= t('admin.news_updated') %><% } %>
        <% if (flash === 'deleted') { %><%= t('admin.news_deleted') %><% } %>
      </div>
    <% } %>

    <% if (news.length === 0) { %>
      <div class="empty-state"><%= t('admin.no_news_admin') %></div>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th></th>
            <th><%= t('admin.news_title_field') %></th>
            <th><%= t('admin.publish_date') %></th>
            <th><%= t('admin.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% news.forEach(function(n) { %>
            <tr>
              <td>
                <% if (n.image) { %><img class="thumb" src="<%= n.image %>" alt="" /><% } else { %><div class="thumb" style="background:#eef2ee;"></div><% } %>
              </td>
              <td><%= n.title %></td>
              <td><%= n.publishedAt %></td>
              <td class="actions-cell">
                <a class="btn btn-small btn-outline" href="/admin/news/<%= n.id %>/edit"><%= t('admin.edit') %></a>
                <form method="POST" action="/admin/news/<%= n.id %>/delete" onsubmit="return confirm('<%= t('admin.confirm_delete_news') %>')">
                  <button class="btn btn-small btn-danger" type="submit"><%= t('admin.delete') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
