<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= article ? t('admin.edit_news') : t('admin.add_news') %> | <%= t('site.title') %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-shell">
  <div class="admin-topbar">
    <span class="brand"><%= t('site.title') %> — <%= article ? t('admin.edit_news') : t('admin.add_news') %></span>
    <a href="/admin/news" style="font-size:0.85rem;color:#cfe4d3;">&larr; <%= t('admin.news_dashboard') %></a>
  </div>

  <div class="admin-main">
    <% if (error) { %><div class="error-msg"><%= error %></div><% } %>

    <form method="POST" enctype="multipart/form-data"
          action="<%= article ? '/admin/news/' + article.id + '/edit' : '/admin/news/new' %>">

      <div class="form-row">
        <div class="form-group">
          <label><%= t('admin.publish_date') %></label>
          <input type="date" name="publishedAt" value="<%= article ? article.publishedAt : new Date().toISOString().slice(0,10) %>" required />
        </div>
        <div class="form-group">
          <label><%= t('admin.image') %></label>
          <input type="file" name="image" accept="image/*" />
        </div>
      </div>

      <% if (article && article.image) { %>
        <div class="current-image-preview">
          <img src="<%= article.image %>" alt="" />
          <span class="hint"><%= t('admin.current_image') %></span>
        </div>
      <% } %>

      <div class="form-group">
        <label><%= t('admin.news_title_field') %></label>
        <input type="text" name="title" value="<%= article ? article.title : '' %>" required />
      </div>
      <div class="form-group">
        <label><%= t('admin.news_summary') %></label>
        <input type="text" name="summary" value="<%= article ? article.summary : '' %>" />
      </div>
      <div class="form-group">
        <label><%= t('admin.news_content') %></label>
        <textarea name="content" style="min-height:220px;"><%= article ? article.content : '' %></textarea>
      </div>

      <div class="form-actions">
        <button class="btn" type="submit"><%= t('admin.save') %></button>
        <a class="btn btn-outline" href="/admin/news"><%= t('admin.cancel') %></a>
      </div>
    </form>
  </div>
</body>
</html>
