<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= t('admin.dashboard') %> | <%= t('site.title') %></title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="admin-shell">
  <div class="admin-topbar">
    <span class="brand"><%= t('site.title') %> — <%= t('admin.dashboard') %></span>
    <div style="display:flex;align-items:center;gap:14px;">
      <span style="font-size:0.85rem;"><%= t('admin.logged_in_as') %>: <%= username %></span>
      <a href="/?lang=<%= lang %>" style="font-size:0.85rem;color:#cfe4d3;"><%= t('nav.home') %></a>
      <form method="POST" action="/admin/logout?lang=<%= lang %>">
        <button class="btn btn-small btn-outline" style="color:white;border-color:rgba(255,255,255,0.4);" type="submit"><%= t('admin.logout') %></button>
      </form>
    </div>
  </div>

  <div class="admin-main">
    <div class="admin-header-row">
      <h1 style="margin:0;color:var(--green-900);font-size:1.3rem;"><%= t('admin.dashboard') %></h1>
      <a class="btn" href="/admin/products/new?lang=<%= lang %>">+ <%= t('admin.add_product') %></a>
    </div>

    <% if (flash) { %>
      <div class="flash-msg">
        <% if (flash === 'created') { %><%= t('admin.created') %><% } %>
        <% if (flash === 'updated') { %><%= t('admin.updated') %><% } %>
        <% if (flash === 'deleted') { %><%= t('admin.deleted') %><% } %>
      </div>
    <% } %>

    <% if (products.length === 0) { %>
      <div class="empty-state"><%= t('admin.no_products_admin') %></div>
    <% } else { %>
      <table class="admin-table">
        <thead>
          <tr>
            <th></th>
            <th><%= t('admin.product_name') %></th>
            <th><%= t('product.category') %></th>
            <th><%= t('product.price') %></th>
            <th><%= t('admin.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(function(p) { %>
            <tr>
              <td>
                <% if (p.image) { %><img class="thumb" src="<%= p.image %>" alt="" /><% } else { %><div class="thumb" style="background:#eef2ee;"></div><% } %>
              </td>
              <td><%= p.translations[lang].name || p.translations.vi.name %></td>
              <td><%= t('categories.' + p.categorySlug) %></td>
              <td><%= p.priceMin %>&ndash;<%= p.priceMax %> <%= p.currency %></td>
              <td class="actions-cell">
                <a class="btn btn-small btn-outline" href="/admin/products/<%= p.id %>/edit?lang=<%= lang %>"><%= t('admin.edit') %></a>
                <form method="POST" action="/admin/products/<%= p.id %>/delete?lang=<%= lang %>" onsubmit="return confirm('<%= t('admin.confirm_delete') %>')">
                  <button class="btn btn-small btn-danger" type="submit"><%= t('admin.delete') %></button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</body>
</html>
